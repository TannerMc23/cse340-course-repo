<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= project.title %></h2>
    <p><strong>Description:</strong> <%= project.description %></p>
    <p><strong>Date:</strong> <%= project.date.toLocaleDateString() %></p>
    <p><strong>Location:</strong> <%= project.location %></p>
    <p><strong>Organization:</strong>
        <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
    </p>

    <h3>Categories</h3>
    <ul>
        <% categories.forEach(category => { %>
            <li>
                <a href="/category/<%= category.category_id %>"><%= category.name %></a>
            </li>
        <% }) %>
    </ul>

    <% if (isLoggedIn) { %>
        <% if (volunteering) { %>
            <p>✅ You are volunteering for this project.</p>
            <form action="/unvolunteer/<%= project.project_id %>" method="POST">
                <button type="submit">Remove me as a volunteer</button>
            </form>
        <% } else { %>
            <form action="/volunteer/<%= project.project_id %>" method="POST">
                <button type="submit">Volunteer for this project</button>
            </form>
        <% } %>
    <% } %>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>
        <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
    <% } %>
</main>
<%- include('partials/footer') %>